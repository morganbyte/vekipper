# development | staging | production
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Supabase. En local: valores de `pnpm db:status`.
# En la nube: Settings > API Keys del proyecto de ese entorno.
SUPABASE_URL=http://127.0.0.1:54321
# Clave secreta (sb_secret_...). Se salta RLS: solo en el backend, nunca en git ni en el navegador.
SUPABASE_SECRET_KEY=

# development | staging | production
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase. En local: valores de `pnpm db:status`.
# En la nube: Settings > API Keys del proyecto de ese entorno.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave publicable (sb_publishable_...). Es segura en el navegador porque RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
